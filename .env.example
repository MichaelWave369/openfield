# Local PostgreSQL/PostGIS evidence spine
DATABASE_URL=postgres://openfield:openfield@localhost:5432/openfield

# Stable identifier for the node creating receipts
OPENFIELD_NODE_ID=local-development-node

# Ed25519 signing keys encoded as base64 DER.
# Private key: PKCS#8 DER. Public key: SPKI DER.
OPENFIELD_SIGNING_KEY_ID=
OPENFIELD_SIGNING_PRIVATE_KEY=
OPENFIELD_SIGNING_PUBLIC_KEY=

# Optional lawful SEC EDGAR connector configuration.
# SEC requires a declared application identity and administrative contact.
OPENFIELD_SEC_CIK=
OPENFIELD_SEC_USER_AGENT=ParallaxOpenField/0.3 admin@example.org
